// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TipoPessoa {
  id    String @id @default(uuid())
  tipo  String
  email String
  senha String

  pessoas Pessoa[]
}

model Pessoa {
  id             String    @id @default(uuid())
  tipoId         String
  nome           String
  cpf            String
  dataNascimento DateTime
  telefone       String
  rua            String
  cidade         String
  numero         Int
  bairro         String
  dataInicio     DateTime
  dataSaida      DateTime?

  tipo    TipoPessoa @relation(fields: [tipoId], references: [id])
  adocoes Adocao[]
}

model Adocao {
  pessoaId   String
  animalId   String
  dataAdocao DateTime

  pessoa Pessoa @relation(fields: [pessoaId], references: [id])
  animal Animal @relation(fields: [animalId], references: [id])

  @@id([pessoaId, animalId])
}

model Animal {
  id             String    @id @default(uuid())
  nome           String
  cor            String
  especie        String
  raca           String
  pelagem        String
  sexo           Boolean  @default(false)
  fivFelv        Boolean   @default(false)
  dataNascimento DateTime?
  dataChegada    DateTime
  motivoSaida    String?
  foto           String?

  adocoes               Adocao[]
  consultas             Consulta[]
  historicosLocalizacao HistoricoLocalizacao[]
  historicosPeso        HistoricoPeso[]
  pesos                 Peso[]
}

model Localizacao {
  id        String  @id @default(uuid())
  nome      String
  tipoLocal String
  ativo     Boolean @default(true)

  historicos HistoricoLocalizacao[]
}

model HistoricoLocalizacao {
  id            String    @id @default(uuid())
  animalId      String
  localizacaoId String
  status        String
  dataEntrada   DateTime
  dataSaida     DateTime?

  animal      Animal      @relation(fields: [animalId], references: [id])
  localizacao Localizacao @relation(fields: [localizacaoId], references: [id])
}

model Peso {
  id             String @id @default(uuid())
  animalId       String
  quantidadePeso Float

  animal     Animal          @relation(fields: [animalId], references: [id])
  historicos HistoricoPeso[]
}

model HistoricoPeso {
  id          String   @id @default(uuid())
  animalId    String
  pesoId      String
  status      String
  dataPesagem DateTime

  animal Animal @relation(fields: [animalId], references: [id])
  peso   Peso   @relation(fields: [pesoId], references: [id])
}

model Clinica {
  id       String @id @default(uuid())
  nome     String
  cnpj     String
  telefone String
  rua      String
  cidade   String
  numero   Int
  bairro   String

  consultas Consulta[]
}

model Motivo {
  id   String @id @default(uuid())
  nome String

  consultas Consulta[]
}

model Consulta {
  id              String    @id @default(uuid())
  clinicaId       String
  animalId        String
  motivoId        String
  observacao      String
  dataAtendimento DateTime
  dataRetorno     DateTime?

  clinica     Clinica     @relation(fields: [clinicaId], references: [id])
  animal      Animal      @relation(fields: [animalId], references: [id])
  motivo      Motivo      @relation(fields: [motivoId], references: [id])
  prescricoes Prescreve[]
}

model Medicamento {
  id   String @id @default(uuid())
  nome String

  prescricoes Prescreve[]
}

model Prescreve {
  id                String @id @default(uuid())
  consultaId        String
  medicamentoId     String
  tipo              String?
  dosagem           String
  quantidade        Int
  frequencia        String
  duracaoTratamento String

  consulta    Consulta    @relation(fields: [consultaId], references: [id])
  medicamento Medicamento @relation(fields: [medicamentoId], references: [id])
}
